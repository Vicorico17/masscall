{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/api/telephony", "dest": "/api/telephony.js" },
    { "src": "/api/demo", "dest": "/api/demo.js" },
    { "src": "/api/studio", "dest": "/api/studio.js" },
    { "src": "/api/prompts", "dest": "/api/prompts.js" },
    { "src": "/studio", "status": 308, "headers": { "Location": "/dashboard" } },
    { "src": "/studio/", "status": 308, "headers": { "Location": "/dashboard" } },
    { "src": "/studio\\.html", "status": 308, "headers": { "Location": "/dashboard" } },
    { "src": "/demo\\.html", "status": 308, "headers": { "Location": "/" } },
    { "src": "/dashboard\\.html", "status": 308, "headers": { "Location": "/dashboard" } },
    { "src": "/", "dest": "/public/demo.html", "headers": { "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY" } },
    { "src": "/dashboard", "dest": "/public/dashboard.html", "headers": { "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY" } },
    { "src": "/(.*)", "dest": "/public/$1", "headers": { "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY" } }
  ]
}
