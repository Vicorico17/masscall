# Set in Vercel. Configure one dedicated Twilio subaccount per workspace.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# At least 24 random characters; never put this token in a public URL.
MASSCALL_ADMIN_TOKEN=
ENABLE_NUMBER_PURCHASES=false
ENABLE_LIVE_CALLS=false
# The bridge runs on a persistent Node host, not a Vercel function.
VOICE_BRIDGE_URL=
VOICE_BRIDGE_SECRET=
# Bridge host only:
OPENAI_API_KEY=
OPENAI_BACKEND_MODEL=gpt-5.6-luna
BRIDGE_PORT=3001

# Public Romanian demo. Keep disabled until every dependency and spend limit is configured.
ENABLE_PUBLIC_DEMO=false
DEMO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
DEMO_HASH_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Customer premium studio. Create a recurring Stripe price; the hosted Checkout page shows its terms.
STUDIO_ENABLED=false
SITE_URL=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
